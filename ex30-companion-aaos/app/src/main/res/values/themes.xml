<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Preserve the existing MainActivity theme on API 32-34. -->
    <style name="Theme.Ex30Companion.Main" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <style name="SetupButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/setup_button</item>
        <item name="android:fontFamily">VolvoNovum-Regular</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minWidth">384dp</item>
        <item name="android:minHeight">96dp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/setup_button_label</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">normal</item>
    </style>
</resources>
