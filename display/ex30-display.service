[Unit]
Description=EX30 Bluetooth driver display
Wants=bluetooth.service seatd.service
After=bluetooth.service seatd.service
StartLimitIntervalSec=0

[Service]
User=ex30-display
StateDirectory=ex30-display
StateDirectoryMode=0700
RuntimeDirectory=ex30-display
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/ex30-display
Environment=LIBSEAT_BACKEND=seatd
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=GDK_BACKEND=wayland
ExecStart=/usr/bin/cage -- /usr/bin/python3 -B /opt/ex30-display/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
